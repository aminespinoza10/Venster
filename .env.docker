# Variables de entorno para Docker Compose
# Copia este archivo a .env y ajusta los valores según tu configuración

# URL de Ollama
# Usa host.docker.internal para acceder a Ollama en tu máquina host (macOS/Windows)
# En Linux, usa la IP de la interfaz docker0 o ejecuta Ollama en un contenedor
OLLAMA_URL=http://host.docker.internal:11434
